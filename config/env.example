# 机密变量模板。
# 用法：cp config/env.example .env  然后填写。
# .env 已在 .gitignore 中，绝不可提交。
# （本模板放在 config/ 下而非仓库根的 .env.example，
#  是为了绕开本地工具对 *.env.* 文件名的写入限制；
#  install.sh 会从这里复制。）

# ---- 必填 ----
# openssl rand -base64 32
# 缺失则拒绝启动（不自动生成：每次重启换密钥会让已存的推送目标全部失效）。
# 丢失后已加密的推送目标无法解密。请备份。
NESTRA_SECRET_KEY=

# ---- LLM providers（启用 LLM 打标时至少填一个；可稍后配置）----
# 未填写时抓取仍运行，文章停在 EXTRACTED 等待可用后端。
# 变量名需与 config.yaml 中各 provider 的 api_key_env 一致
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# ---- 可选 ----
# Docker bind mount 权限。通常无需修改；若 data/ 属于其他用户，填 `id -u` / `id -g`。
NESTRA_UID=1000
NESTRA_GID=1000
# runtime（默认）/ runtime-render / runtime-local / runtime-full
NESTRA_IMAGE_TARGET=runtime

# 留空则首次启动生成一次性 setup token 打印到容器日志，
# 访问 /setup?token=... 创建管理员。不存在默认凭据。
NESTRA_ADMIN_PASSWORD=

NESTRA__APP__LOG_LEVEL=INFO
TZ=Asia/Shanghai
